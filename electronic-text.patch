@@ -0,0 +1,83 @@
+/* layout: one column, the stanza cascades down and to the right like layered cloth; controls sit under it */
+:root {
+  --paper: #ffffff;
+  --ink: #0a0a0a;
+  --ink-soft: #6b6b6b;
+  --ink-faint: #bdbdbd;
+  --rule: #e2e2e2;
+  --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+  --step: 5ch;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) { --paper: #0a0a0a; --ink: #f5f5f5; --ink-soft: #9a9a9a; --ink-faint: #4a4a4a; --rule: #262626; color-scheme: dark; }
+}
+:root[data-theme="dark"] { --paper: #0a0a0a; --ink: #f5f5f5; --ink-soft: #9a9a9a; --ink-faint: #4a4a4a; --rule: #262626; color-scheme: dark; }
+
+* { box-sizing: border-box; }
+html, body { min-height: 100%; }
+body {
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--mono);
+  font-size: 15px;
+  line-height: 1.6;
+  padding-block: 40px 56px;
+  padding-inline: 24px;
+}
+.wrap { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px; }
+
+header { display: flex; flex-direction: column; gap: 8px; max-width: 62ch; }
+h1 { font-size: 15px; font-weight: 500; margin: 0; letter-spacing: 0.01em; }
+header p { margin: 0; color: var(--ink-soft); font-weight: 300; }
+
+#stage {
+  appearance: none; background: none; border: 0; color: inherit; font: inherit; text-align: left;
+  padding: 0; cursor: pointer; display: flex; flex-direction: column; gap: 36px; min-width: 0;
+}
+#stage:focus-visible { outline: 1px dashed var(--ink); outline-offset: 12px; }
+
+.stanza { display: flex; flex-direction: column; font-size: clamp(15px, 1.6vw + 8px, 20px); line-height: 1.75; }
+.stanza.old { color: var(--ink-faint); font-size: 15px; line-height: 1.6; }
+.line { padding-left: calc(var(--i) * var(--step)); text-indent: -2ch; margin-left: 2ch; min-width: 0; overflow-wrap: anywhere; }
+.line.pending { visibility: hidden; }
+.w { font-weight: 500; }
+.stanza.old .w { font-weight: 400; }
+
+.controls { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; border-top: 1px solid var(--rule); padding-top: 20px; }
+.group { display: flex; gap: 0; border: 1px solid var(--ink); }
+.group button, .toggle, .again {
+  font: inherit; font-size: 13px; color: var(--ink); background: var(--paper); border: 0; padding: 6px 12px; cursor: pointer;
+}
+.group button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
+.group button + button { border-left: 1px solid var(--ink); }
+.toggle { padding: 6px 0; display: inline-flex; gap: 8px; align-items: center; }
+.again { border: 1px solid var(--ink); margin-left: auto; }
+.again:hover, .group button:hover { text-decoration: underline; }
+button:focus-visible { outline: 1px dashed var(--ink); outline-offset: 3px; }
+.panel { display: flex; flex-direction: column; gap: 16px; }
+.yours { display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--ink); padding: 20px; }
+.yours-intro { margin: 0; color: var(--ink-soft); font-weight: 300; font-size: 13px; max-width: 62ch; }
+.fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 14px 24px; }
+.fields label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--ink-soft); min-width: 0; }
+.fields input { font: inherit; font-size: 14px; color: var(--ink); background: var(--paper); border: 0; border-bottom: 1px solid var(--ink-faint); padding: 4px 0; border-radius: 0; width: 100%; }
+.fields input::placeholder { color: var(--ink-faint); }
+.fields input:focus { outline: none; border-bottom-color: var(--ink); }
+.form-actions { display: flex; gap: 20px; align-items: center; }
+.form-actions .again { margin-left: 0; }
+.w.mine { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
+.hint { margin: 0;  color: var(--ink-soft); font-size: 13px; font-weight: 300; }
+
+footer { color: var(--ink-soft); font-size: 12px; font-weight: 300; max-width: 62ch; display: flex; flex-direction: column; gap: 6px; }
+footer p { margin: 0; }
+
+@media (max-width: 560px) {
+  :root { --step: 2ch; }
+  body { padding-inline: 16px; padding-block: 28px 40px; }
+  .again { margin-left: 0; }
+}
+@media (prefers-reduced-motion: reduce) { .line.pending { visibility: visible; } }
+
+/* embedded on electrocute.io/electronic-text: the host page supplies the title and notes */
+.embed body { padding-block: 8px 24px; padding-inline: 4px; }
+.embed header, .embed footer { display: none; }
+.embed .wrap { gap: 32px; }
