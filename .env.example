# shared visitor state (felt button counter, communal sampler, receipt guestbook)
# create a free redis database at https://console.upstash.com and paste the
# REST url + token below. locally: copy this file to .env.local. on vercel:
# add both under project settings -> environment variables.
#
# without these the site still works; the widgets just keep
# per-device counts in localStorage instead of shared ones.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
