# copy this file to .env.local (or add both in your vercel project settings)
# to share the felt button, punch card, archive and guest receipt across visitors.
# get the values from your database page in the upstash console.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"
